# Copy the settings you need into the repository-root .env.local file.
# Never prefix provider credentials with VITE_: Vite exposes VITE_ values publicly.

# Broker. The unauthenticated switch is deliberately accepted only for loopback
# requests outside production; remove it as soon as SpacetimeAuth is configured.
BROKER_HOST=127.0.0.1
BROKER_PORT=8787
BROKER_ALLOW_UNAUTHENTICATED_LOCAL=false
BROKER_OIDC_ISSUER=https://auth.spacetimedb.com/oidc
BROKER_OIDC_CLIENT_ID=
BROKER_ALLOWED_SUBJECTS=
BROKER_ALLOWED_EMAILS=

# Supabase Management API. Use a fine-grained project token with Project Settings
# Read + Database Read; do not use service_role or an sb_secret project key.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_SOURCE_TABLE=public.proactive_events

# LangSmith. Use a workspace-scoped service key and the UUIDs (not display names).
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
LANGSMITH_SOURCE_PROJECT_ID=

# Supermemory. Prefer a key scoped to exactly this container tag.
SUPERMEMORY_API_KEY=
SUPERMEMORY_CONTAINER_TAG=proactive-demo
SUPERMEMORY_BASE_URL=https://api.supermemory.ai
SUPERMEMORY_SAMPLE_QUERY=What recent incident context is relevant?

# A separate SpacetimeDB data source, not Proactive's coordination database.
# Leave the token empty for a curated public table. Never use a database-owner or
# CLI publisher token: owners bypass table visibility controls during SQL queries.
SPACETIME_SOURCE_HOST=https://maincloud.spacetimedb.com
SPACETIME_SOURCE_DATABASE=
SPACETIME_SOURCE_TABLE=
SPACETIME_SOURCE_TOKEN=

# Browserbase. Project API key stays on the server. The war room iframe only
# receives a time-limited Live View URL.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_BASE_URL=https://api.browserbase.com
