# Public browser configuration. These VITE_ values are safe to expose.
VITE_SPACETIMEDB_HOST=ws://localhost:3000
VITE_SPACETIMEDB_DB_NAME=proactive
VITE_OIDC_AUTHORITY=https://auth.spacetimedb.com/oidc
VITE_OIDC_CLIENT_ID=

# Local connector broker. The unauthenticated switch works only for loopback
# requests outside production. Remove it after SpacetimeAuth is configured.
# Azure App Service injects PORT, which takes precedence over BROKER_PORT.
BROKER_HOST=127.0.0.1
BROKER_PORT=8787
BROKER_ALLOW_UNAUTHENTICATED_LOCAL=false
BROKER_OIDC_ISSUER=https://auth.spacetimedb.com/oidc
BROKER_OIDC_CLIENT_ID=
# This alpha has one global connector environment, so explicitly allow only
# your pilot users. Prefer stable OIDC subjects; verified emails are convenient.
BROKER_ALLOWED_SUBJECTS=
BROKER_ALLOWED_EMAILS=

# Supabase Management API. Use a fine-grained token with Project Settings Read
# and Database Read. Never use a project service_role or sb_secret key here.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_SOURCE_TABLE=public.proactive_events

# LangSmith. Prefer a workspace-scoped service key.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
LANGSMITH_SOURCE_PROJECT_ID=

# Supermemory. Prefer a short-lived key scoped to this exact container.
SUPERMEMORY_API_KEY=
SUPERMEMORY_CONTAINER_TAG=proactive-demo
SUPERMEMORY_BASE_URL=https://api.supermemory.ai
SUPERMEMORY_SAMPLE_QUERY=What recent incident context is relevant?

# Optional separate SpacetimeDB source. This is not Proactive's coordination
# database. Never use a database-owner or CLI publisher token for SQL reads.
SPACETIME_SOURCE_HOST=https://maincloud.spacetimedb.com
SPACETIME_SOURCE_DATABASE=
SPACETIME_SOURCE_TABLE=
SPACETIME_SOURCE_TOKEN=

# Browserbase is the next execution/display slice; it is not wired yet.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
